# Runtime Mode & Server Port
NODE_ENV="production"
PORT="3000"

# Production Domain URL (used for OAuth callbacks, invite links, and webhooks)
APP_URL="https://sdglobalit.com"

# Persistent Data Storage Directories (Optional: mount a persistent volume path in production)
DATA_DIR=""
UPLOADS_DIR=""

# JWT_SECRET: Strong random signing secret for continuous session tokens (min 32 chars).
# If left empty, the server automatically generates and persists a 256-bit secret in the database.
JWT_SECRET=""

# Google Drive Automatic Backup & 1-Second Sync Target Folder
GOOGLE_DRIVE_FOLDER_URL="https://drive.google.com/drive/folders/18ub4PwnI3r9io--dCEULoQPW-vPW_ihT?usp=drive_link"

# GEMINI_API_KEY: Optional (AI Studio injects at runtime if AI features are used)
GEMINI_API_KEY=""

# Microsoft Outlook OAuth 2.0 & Graph API Configuration (Optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Meta WhatsApp Business Cloud API Configuration (Optional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN=""
