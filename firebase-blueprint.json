        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["idNum", "reportType", "title", "rowCount", "createdByName", "createdByRole", "payload", "ownerUid", "createdAt", "updatedAt"]
    },
    "CrmRecord": {
      "title": "CrmRecord",
      "description": "Auxiliary relational table row (ticket logs, asset maintenance, approvals, permissions, settings, audit logs).",
      "type": "object",
      "properties": {
        "tableName": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_]+$" },
        "sourceKey": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dataMap": { "type": "object" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableName", "sourceKey", "dataMap", "ownerUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized Cloud CRM administrator registry."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Startup Firestore connection check document."
    },
    "/crm_meta/{metaId}": {
      "schema": { "$ref": "#/entities/CrmMeta" },
      "description": "Lifetime database checkpoint and record summary."
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Warehouses, Branches, Corporate Offices, and Operational Hubs."
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Company departments and cost centers."
    },
    "/crm_users/{userId}": {
      "schema": { "$ref": "#/entities/CrmUser" },
      "description": "CRM user accounts (admin-restricted PII)."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee directory records (admin-restricted PII)."
    },
    "/moderators/{moderatorId}": {
      "schema": { "$ref": "#/entities/Moderator" },
      "description": "Moderator engineer profiles (admin-restricted PII)."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Support tickets and workflow state."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "IT assets and hardware inventory."
    },
    "/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "IT budgets by fiscal year, month, location, and category."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "IT expenses and vendor invoices."
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "IT vendors and service providers."
    },
    "/direct_messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Direct and task chat messages."
    },
    "/broadcast_notifications/{broadcastId}": {
      "schema": { "$ref": "#/entities/BroadcastNotification" },
      "description": "Broadcast notifications and announcements."
    },
    "/dropdown_options/{optionId}": {
      "schema": { "$ref": "#/entities/DropdownOption" },
      "description": "Dynamic dropdown options managed in Dropdown Manager."
    },
    "/sla_configurations/{slaId}": {
      "schema": { "$ref": "#/entities/SlaConfiguration" },
      "description": "SLA policy targets and escalation config."
    },
    "/saved_reports/{reportId}": {
      "schema": { "$ref": "#/entities/SavedReport" },
      "description": "Saved operational and financial reports."
    },
    "/crm_records/{recordId}": {
      "schema": { "$ref": "#/entities/CrmRecord" },
      "description": "Auxiliary operational records across related tables."
    }
  }
}
